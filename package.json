{
  "name": "bootcat-extension",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs all",
    "build:chromium": "node scripts/build.mjs chromium",
    "build:firefox": "node scripts/build.mjs firefox",
    "package": "node scripts/package.mjs all",
    "package:chromium": "node scripts/package.mjs chromium",
    "package:firefox": "node scripts/package.mjs firefox",
    "test": "node --test",
    "test:browser": "node scripts/smoke-chromium.cjs",
    "test:popup": "node scripts/smoke-popup.cjs",
    "lint:firefox": "node scripts/build.mjs firefox && web-ext lint --source-dir dist/firefox",
    "dev:firefox": "node scripts/build.mjs firefox && web-ext run --source-dir dist/firefox"
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.7",
    "playwright": "1.62.1"
  }
}
